rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'maxshivam999@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin collection to manage authorized admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Enquiries: Customers can submit enquiries; only admins can list, read and manage them
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.phone is string &&
                       request.resource.data.destination is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 150 &&
                       request.resource.data.phone.size() >= 7 &&
                       request.resource.data.phone.size() <= 25;
      allow read, update, delete: if isAdmin();
    }

    // Bookings: Customers can submit booking requests; admins can view and confirm
    match /bookings/{bookingId} {
      allow create: if request.resource.data.bookingType is string &&
                       request.resource.data.passengerName is string &&
                       request.resource.data.passengerPhone is string &&
                       request.resource.data.passengerName.size() > 0 &&
                       request.resource.data.passengerName.size() <= 150 &&
                       request.resource.data.totalFare is number &&
                       request.resource.data.totalFare >= 0;
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Tour Packages: Publicly readable; admin editable
    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Destinations: Publicly readable; admin editable
    match /destinations/{destinationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Bus Routes: Publicly readable; admin editable
    match /busRoutes/{routeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Scheduled Buses: Publicly readable; admin editable
    match /buses/{busId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Testimonials: Publicly readable; admin editable
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Site Settings: Publicly readable; admin editable
    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
